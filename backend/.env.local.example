# Local-only overrides loaded after backend/.env.server.
# Copy the values you need into backend/.env.local.

APP_FRONTEND_BASE_URL=http://localhost:5173
APP_STORAGE_LOCAL_ROOT_PATH=./storage

# OpenAPI spec (/v3/api-docs) and Swagger UI (/swagger-ui.html). Keep false on the server.
SPRINGDOC_ENABLED=true
